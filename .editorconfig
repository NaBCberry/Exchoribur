# 精简版。安装 .NET SDK 后可执行 `dotnet new editorconfig` 生成包含完整
# 分析器规则集的版本,再按本项目需要裁剪。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
indent_size = 4

# Avalonia 的 XAML、MSBuild 工程文件、JSON、YAML 约定为 2 空格
[*.{axaml,xaml,xml,csproj,props,targets,sln,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# using 指令排序:系统命名空间在前
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# 大括号与命名空间
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning

# 限定符:不使用 this. 和类型名限定
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# 类型推断与表达式体
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# 其他常见偏好
csharp_prefer_braces = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion

# 需要 using 但未使用时应移除
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# 类型与成员命名。静态只读字段和常量沿用 PascalCase,实例私有字段用 _camelCase。
dotnet_naming_rule.interfaces.severity = warning
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = interface_name
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_name.required_prefix = I
dotnet_naming_style.interface_name.capitalization = pascal_case

dotnet_naming_rule.types.severity = warning
dotnet_naming_rule.types.symbols = types
dotnet_naming_rule.types.style = pascal
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate

dotnet_naming_rule.members.severity = warning
dotnet_naming_rule.members.symbols = members
dotnet_naming_rule.members.style = pascal
dotnet_naming_symbols.members.applicable_kinds = property, event

dotnet_naming_rule.methods.severity = warning
dotnet_naming_rule.methods.symbols = methods
dotnet_naming_rule.methods.style = pascal
dotnet_naming_symbols.methods.applicable_kinds = method

dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = private_field
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.private_field.required_prefix = _
dotnet_naming_style.private_field.capitalization = camel_case

dotnet_naming_rule.static_readonly_fields.severity = warning
dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields.style = pascal
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.constants.severity = warning
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

[tests/**/*.cs]
# 测试方法保留便于阅读的下划线句式,其他命名规则照常检查。
dotnet_naming_rule.methods.severity = none

[*.g.cs]
generated_code = true

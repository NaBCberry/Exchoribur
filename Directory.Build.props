<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 在编译阶段需要文档生成;只忽略“缺少文档”,仍检查写错的文档。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- 只将明确采用的规范作为错误,避免一次升级把所有可选分析规则变成阻断。 -->
    <WarningsAsErrors>$(WarningsAsErrors);IDE0005;IDE0161;IDE1006</WarningsAsErrors>
    <!--
      版本号的唯一来源。发布流程（scripts/release.ps1 与 Actions 的一键发布）
      只改这一处,标签必须写成 v + 这里的版本号。
    -->
    <Version>0.1.2-beta.1</Version>
  </PropertyGroup>
</Project>

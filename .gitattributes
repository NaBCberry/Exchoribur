# 默认:文本文件在仓库内统一使用 LF,检出时也保持 LF。
# 这与 .editorconfig 的 end_of_line = lf 保持一致,避免编辑器写入的换行符
# 与检出结果互相打架。
* text=auto eol=lf

# 批处理脚本保持 CRLF:部分 cmd 语法在 LF 下行为不一致
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.flac binary
*.mp4 binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary

# 跨平台协作时避免 diff 噪音
*.lock linguist-generated=true
*.Designer.cs linguist-generated=true

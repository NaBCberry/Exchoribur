<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LightFlow.App.ViewModels"
        xmlns:controls="using:LightFlow.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="LightFlow.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="{Binding WindowTitle}"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ChromeBackgroundBrush}">
            <MenuItem Header="文件">
                <MenuItem Header="打开…"
                          Command="{Binding OpenCommand}"
                          InputGesture="Ctrl+O">
                    <MenuItem.Icon>
                        <Path Classes="icon small" Data="{x:Static controls:Icons.OpenProject}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="编辑" IsEnabled="False" />
            <MenuItem Header="视图" IsEnabled="False" />
            <MenuItem Header="帮助">
                <MenuItem Header="关于 LightFlow" IsEnabled="False">
                    <MenuItem.Icon>
                        <Path Classes="icon small" Data="{x:Static controls:Icons.About}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 底部状态栏:打开文件的结果、报错都显示在这里 -->
        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="{DynamicResource ChromeBackgroundBrush}">
            <TextBlock Classes="status"
                       Classes.error="{Binding HasError}"
                       Text="{Binding StatusText}"
                       Margin="12,0"
                       VerticalAlignment="Center" />
        </Border>

        <Grid ColumnDefinitions="340,*">
            <!-- 左栏:视频预览 + 播放控制 + 十通道状态 -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" Margin="8">
                <Border Grid.Row="0" Classes="panel" Height="191">
                    <TextBlock Classes="hint" Text="视频预览" />
                </Border>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8">
                    <Button Classes="transport"
                            ToolTip.Tip="回到开头"
                            Command="{Binding GoToStartCommand}">
                        <Path Classes="icon" Data="{x:Static controls:Icons.GoToStart}" />
                    </Button>
                    <Button Classes="transport" ToolTip.Tip="上一帧">
                        <Path Classes="icon" Data="{x:Static controls:Icons.PreviousFrame}" />
                    </Button>
                    <Button Classes="transport" ToolTip.Tip="播放">
                        <Path Classes="icon" Data="{x:Static controls:Icons.Play}" />
                    </Button>
                    <Button Classes="transport" ToolTip.Tip="暂停">
                        <Path Classes="icon" Data="{x:Static controls:Icons.Pause}" />
                    </Button>
                    <Button Classes="transport" ToolTip.Tip="停止">
                        <Path Classes="icon" Data="{x:Static controls:Icons.Stop}" />
                    </Button>
                    <Button Classes="transport" ToolTip.Tip="下一帧">
                        <Path Classes="icon" Data="{x:Static controls:Icons.NextFrame}" />
                    </Button>
                    <Button Classes="transport"
                            ToolTip.Tip="跳到结尾"
                            Command="{Binding GoToEndCommand}">
                        <Path Classes="icon" Data="{x:Static controls:Icons.GoToEnd}" />
                    </Button>
                </StackPanel>

                <!-- 缩放:滚轮也能缩放和平移,这几个按钮是给不方便用滚轮的时候 -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="4"
                            Margin="0,0,0,8">
                    <Button Classes="transport"
                            ToolTip.Tip="放大(滚轮向上)"
                            Command="{Binding ZoomInCommand}">
                        <Path Classes="icon" Data="{x:Static controls:Icons.ZoomIn}" />
                    </Button>
                    <Button Classes="transport"
                            ToolTip.Tip="缩小(滚轮向下)"
                            Command="{Binding ZoomOutCommand}">
                        <Path Classes="icon" Data="{x:Static controls:Icons.ZoomOut}" />
                    </Button>
                    <Button Classes="transport"
                            ToolTip.Tip="适配全部"
                            Command="{Binding FitAllCommand}">
                        <Path Classes="icon" Data="{x:Static controls:Icons.FitAll}" />
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Classes="panel">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="10,8,0,4">
                            <Path Classes="icon small" Data="{x:Static controls:Icons.LightStatus}" />
                            <TextBlock Classes="panelTitle" Text="通道状态" />
                        </StackPanel>
                        <controls:LightStatusControl CurrentFrame="{Binding CurrentFrame}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右栏:时间轴(主区域)+ 与时间轴对齐的音频波形 -->
            <Grid Grid.Column="1" RowDefinitions="*,110" Margin="0,8,8,8">
                <Border Grid.Row="0" Classes="panel" Margin="0,0,0,8">
                    <!-- 两层叠在一起:下面画色块和标记,上面只画播放头,
                         拖播放头时只重画上面那层。 -->
                    <Grid ClipToBounds="True">
                        <controls:TimelineControl
                            Frames="{Binding Frames}"
                            Markers="{Binding Markers}"
                            Viewport="{Binding Viewport}"
                            PlayheadTime="{Binding PlayheadTime, Mode=TwoWay}"
                            Cursor="Hand" />
                        <controls:PlayheadControl
                            Viewport="{Binding Viewport}"
                            PlayheadTime="{Binding PlayheadTime}"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="panel">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7">
                        <Path Classes="icon small" Data="{x:Static controls:Icons.AudioWaveform}" />
                        <TextBlock Classes="hint" Text="音频波形(待接入)" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>

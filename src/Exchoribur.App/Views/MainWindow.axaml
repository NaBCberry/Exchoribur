<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Exchoribur.App.ViewModels"
        xmlns:controls="using:Exchoribur.App.Controls"
        xmlns:timeline="using:Exchoribur.App.TimelineUi"
        xmlns:views="using:Exchoribur.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="using:Exchoribur.App.Resources"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="Exchoribur.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon-symbol.ico"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="{Binding WindowTitle}"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoEditsCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoEditsCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding CopyBlockToOtherChannelsCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedBlocksCommand}" />
        <KeyBinding Gesture="Shift+Delete" Command="{Binding DeleteSelectedFramesCommand}" />
        <KeyBinding Gesture="Insert" Command="{Binding InsertFrameAtPlayheadCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ChromeBackgroundBrush}">
            <MenuItem Header="{x:Static res:Strings.MainMenuFile}">
                <MenuItem Header="{x:Static res:Strings.MainMenuOpenProject}" Command="{Binding OpenProjectCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.OpenProject}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuSaveProject}" Command="{Binding SaveProjectCommand}" InputGesture="Ctrl+S">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Save}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuSaveProjectAs}" Command="{Binding SaveProjectAsCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.SaveAs}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuImportTimeline}"
                          Command="{Binding OpenCommand}"
                          InputGesture="Ctrl+O">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Import}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuImportMedia}" Command="{Binding ImportVideoCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.ImportMedia}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuExportTimeline}" Command="{Binding ExportTimelineCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Export}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuExit}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MainMenuEdit}">
                <MenuItem Header="{Binding UndoLabel}"
                          Command="{Binding UndoEditsCommand}"
                          InputGesture="Ctrl+Z">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Undo}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding RedoLabel}"
                          Command="{Binding RedoEditsCommand}"
                          InputGesture="Ctrl+Y">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Redo}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuSelectAll}" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Channels}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuClearSelection}"
                          Command="{Binding ClearSelectionCommand}"
                          InputGesture="Escape" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuCopyToOtherChannels}"
                          Command="{Binding CopyBlockToOtherChannelsCommand}"
                          InputGesture="Ctrl+D">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Copy}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuRenameBlock}" Command="{Binding RenameSelectedBlockCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.SetFunction}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuUsePlayheadColor}" Command="{Binding SetSelectionColorCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.SetColor}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuInsertFrame}"
                          Command="{Binding InsertFrameAtPlayheadCommand}"
                          InputGesture="Insert">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.InsertFrame}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuDeleteFrames}"
                          Command="{Binding DeleteSelectedFramesCommand}"
                          InputGesture="Shift+Delete">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Delete}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuDeleteBlocks}"
                          Command="{Binding DeleteSelectedBlocksCommand}"
                          InputGesture="Delete">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Delete}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuSettings}" Click="OnSettingsClick">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Settings}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MainMenuView}" IsEnabled="False" />
            <MenuItem Header="{x:Static res:Strings.MainMenuHelp}">
                <MenuItem Header="{x:Static res:Strings.MainMenuAbout}" IsEnabled="False">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.About}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 底部状态栏:打开文件的结果、报错、保存进度都显示在这里 -->
        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="{DynamicResource ChromeBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Classes="status"
                           Classes.error="{Binding HasError}"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center" />
                <!-- 只在保存时出现的细进度条:打包大素材要等几十秒,没有它看不出还在动 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ProgressBar Width="140"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding SaveProgress}"
                                 IsVisible="{Binding IsSaving}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />

                    <!-- 自动更新的提示:平时不出现,不占地方 -->
                    <Path Classes="icon"
                          Data="{x:Static controls:Icons.Download}"
                          IsVisible="{Binding IsUpdateBannerVisible}" />
                    <TextBlock Classes="update"
                               Text="{Binding UpdateBannerText}"
                               IsVisible="{Binding IsUpdateBannerVisible}" />
                    <Button Classes="transport"
                            ToolTip.Tip="{x:Static res:Strings.MainTooltipApplyUpdate}"
                            Command="{Binding ApplyUpdateCommand}"
                            IsVisible="{Binding IsUpdateApplyVisible}">
                        <Path Classes="icon" Data="{x:Static controls:Icons.Refresh}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 全局播放条:这些控件管的是整条时间线,不属于某一块面板 -->
        <Border DockPanel.Dock="Bottom"
                Height="44"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <!--
                两侧列必须等宽(都是星号列),中间那组控件才会正好落在窗口正中;
                写成 Auto 的话左列宽度就等于读数框本身,右对齐也就无从谈起。
            -->
            <Grid ColumnDefinitions="*,Auto,*" Margin="12,0">
                <!--
                    播放条按"槽位"排:中间那组控件固定居中,左右各一个槽位放显示面板。
                    两侧列都是星号列、宽度相等,所以左右面板宽窄怎么变都不会推走中间。
                    槽位内的顺序就是离中心的远近,越靠后越靠外;面板绑自己的 IsVisible,
                    隐藏的项不占位,后面的自动顶上。
                -->
                <StackPanel x:Name="LeftSlot"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Spacing="8">
                    <!-- 走带光标所在处的时间,紧贴中间按钮组的左边 -->
                    <Border Classes="readout">
                        <TextBlock Classes="clock"
                                   Text="{Binding PlayheadText}"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                <Button Classes="transport"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipGoToStart}"
                        Command="{Binding GoToStartCommand}">
                    <Path Classes="icon title" Data="{x:Static controls:Icons.GoToStart}" />
                </Button>
                <Button Classes="transport"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipPreviousFrame}"
                        Command="{Binding PreviousFrameCommand}">
                    <Path Classes="icon title" Data="{x:Static controls:Icons.PreviousFrame}" />
                </Button>
                <Button Classes="transport"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipNextFrame}"
                        Command="{Binding NextFrameCommand}">
                    <Path Classes="icon title" Data="{x:Static controls:Icons.NextFrame}" />
                </Button>
                <Button Classes="transport"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipGoToEnd}"
                        Command="{Binding GoToEndCommand}">
                    <Path Classes="icon title" Data="{x:Static controls:Icons.GoToEnd}" />
                </Button>

                <!-- 播放和暂停合成一个按钮:暂停时显示播放三角,播放时显示暂停条 -->
                <Button Classes="transport primary play"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipPlayPause}"
                        Command="{Binding TogglePlayCommand}">
                    <Panel>
                        <Path Classes="icon big play"
                              Data="{x:Static controls:Icons.Play}"
                              IsVisible="{Binding IsPaused}" />
                        <Path Classes="icon big play"
                              Data="{x:Static controls:Icons.Pause}"
                              IsVisible="{Binding IsPlaying}" />
                    </Panel>
                </Button>
                <Button Classes="transport primary stop"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipStop}"
                        Command="{Binding StopPlaybackCommand}">
                    <Path Classes="icon big stop" Data="{x:Static controls:Icons.Stop}" />
                </Button>
                <ToggleButton Classes="transport primary loop"
                              ToolTip.Tip="{x:Static res:Strings.MainTooltipLoop}"
                              IsChecked="{Binding IsLooping}">
                    <Path Classes="icon big loop" Data="{x:Static controls:Icons.Loop}" />
                </ToggleButton>

                <!-- 链接开关:白色=没选块;亮黄=选中的块都已链接(再点解除);紫色=混合(点一下重新链成一伙) -->
                <Border Width="1"
                        Height="20"
                        Margin="8,0"
                        Background="{DynamicResource PanelBorderBrush}" />
                <Button Classes="transport"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipLink}"
                        Command="{Binding ToggleLinkCommand}">
                    <Path Classes="icon big"
                          Data="{x:Static controls:Icons.Link}"
                          Stroke="{Binding LinkIconBrush}" />
                </Button>
                </StackPanel>

                <!-- 右槽位:以后摆在按钮组右边的显示面板加在这里 -->
                <StackPanel x:Name="RightSlot"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Spacing="8" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="340,*">
            <!-- 左栏:视频预览(播放控制压在它底部)+ 十通道状态(缩放压在它底部) -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="8">
                <Border Grid.Row="0" Classes="panel" Height="191">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="10,8,0,4">
                            <Path Classes="icon title" Data="{x:Static controls:Icons.ImportMedia}" />
                            <TextBlock Classes="panelTitle" Text="{x:Static res:Strings.MainPanelVideoPreview}" />
                        </StackPanel>

                        <!-- 视频画面是 libvlc 的原生子窗口,必须从一开始就在可视树里:
                             等到导入视频才显示的话,宿主窗口还没建出来 VLC 就会自己弹窗,
                             而且它盖在 Avalonia 内容之上,面板标题不能压在它身上。 -->
                        <controls:VideoSurface Frame="{Binding VideoFrame}"
                                               FrameVersion="{Binding VideoFrameVersion}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Classes="panel" Margin="0,8,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="10,8,0,4">
                            <Path Classes="icon title" Data="{x:Static controls:Icons.LightStatus}" />
                            <TextBlock Classes="panelTitle" Text="{x:Static res:Strings.MainPanelChannelState}" />
                        </StackPanel>

                        <controls:LightStatusControl CurrentFrame="{Binding CurrentFrame}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右栏:时间轴(主区域)+ 与时间轴对齐的音频波形,最右边是颜色面板 -->
            <DockPanel Grid.Column="1" Margin="0,8,8,8">
                <!-- 右边这一列是颜色面板:先把它停靠好,剩下的地方留给时间轴 -->
                <Border DockPanel.Dock="Right"
                        Classes="panel"
                        Width="220"
                        Margin="8,0,0,0">
                    <views:ColorPanelView />
                </Border>

                <Grid RowDefinitions="*,110">
                    <Border Grid.Row="0" Classes="panel" Margin="0,0,0,8">
                        <DockPanel>
                            <!-- 底部留一条窄条专门放缩放按钮,不压在轨道色块上 -->
                            <Border DockPanel.Dock="Bottom"
                                    Height="26"
                                    Background="{DynamicResource ChromeBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,3,3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <!-- 滚轮分工提示:窗口窄的时候省略号收尾,不挤走右边的按钮 -->
                                    <TextBlock Grid.Column="0"
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource DimTextBrush}"
                                               FontSize="12"
                                               Text="{x:Static res:Strings.MainTimelineWheelHint}" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="2"
                                                Margin="0,0,6,0">
                                        <Button Classes="transport"
                                                ToolTip.Tip="{x:Static res:Strings.MainTooltipZoomIn}"
                                                Command="{Binding ZoomInCommand}">
                                            <Path Classes="icon" Data="{x:Static controls:Icons.ZoomIn}" />
                                        </Button>
                                        <Button Classes="transport"
                                                ToolTip.Tip="{x:Static res:Strings.MainTooltipZoomOut}"
                                                Command="{Binding ZoomOutCommand}">
                                            <Path Classes="icon" Data="{x:Static controls:Icons.ZoomOut}" />
                                        </Button>
                                        <Button Classes="transport"
                                                ToolTip.Tip="{x:Static res:Strings.MainTooltipFitAll}"
                                                Command="{Binding FitAllCommand}">
                                            <Path Classes="icon" Data="{x:Static controls:Icons.FitAll}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
    
                            <!-- 刻度、标记、十条轨道、播放头都在同一个控件里画,
                                 免得滚动时各层落在不同的合成帧上对不齐。 -->
                            <Grid ClipToBounds="True">
                                <timeline:TimelineControl
                                    Blocks="{Binding Blocks}"
                                    Markers="{Binding Markers}"
                                    Viewport="{Binding Viewport}"
                                    PlayheadTime="{Binding PlayheadTime, Mode=TwoWay}"
                                    SelectedBlocks="{Binding SelectedBlocks, Mode=TwoWay}"
                                    CurrentBlockId="{Binding CurrentBlockId}"
                                    BottomOverlayHeight="{Binding EditorOverlayHeight}"
                                    EnsureVisibleChannel="{Binding CurrentBlockChannel}"
                                    InvertMouseWheel="{Binding Settings.InvertMouseWheel}"
                                    InvertTouchpadScroll="{Binding Settings.InvertTouchpadScroll}"
                                    BlockCreateRequested="OnBlockCreateRequested"
                                    BlockMoveRequested="OnBlockMoveRequested"
                                    BlockOpenRequested="OnBlockOpenRequested"
                                    Cursor="Hand" />

                                <!-- 块编辑器:盖在轨道上面(不挤压轨道),打开时主时间轴会把选中的块滚到它上面 -->
                                <Border VerticalAlignment="Bottom"
                                        Height="{Binding EditorOverlayHeight}"
                                        IsVisible="{Binding HasCurrentBlock}"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        BoxShadow="0 -8 18 0 #88000000">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="10,6,0,2">
                                            <Path Classes="icon title" Data="{x:Static controls:Icons.SetColor}" />
                                            <TextBlock Classes="panelTitle" Text="{x:Static res:Strings.MainPanelBlockEditor}" />
                                            <TextBlock Classes="panelTitle" Text="{Binding CurrentBlockTitle}" />
                                        </StackPanel>

                                        <timeline:BlockEditorControl
                                            Blocks="{Binding Blocks}"
                                            CurrentBlock="{Binding CurrentBlock}"
                                            Viewport="{Binding BlockEditorViewport}"
                                            PlayheadTime="{Binding PlayheadTime, Mode=TwoWay}"
                                            SelectedFrames="{Binding SelectedFrames, Mode=TwoWay}"
                                            FocusTime="{Binding CurrentBlockFocus}"
                                            FocusSpacing="{Binding CurrentBlockSpacing}"
                                            InvertMouseWheel="{Binding Settings.InvertMouseWheel}"
                                            InvertTouchpadScroll="{Binding Settings.InvertTouchpadScroll}" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
    
                <Border Grid.Row="1" Classes="panel">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="7">
                            <Path Classes="icon title" Data="{x:Static controls:Icons.AudioWaveform}" />
                            <TextBlock Classes="hint" Text="{x:Static res:Strings.MainAudioWaveformPlaceholder}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>

</Window>

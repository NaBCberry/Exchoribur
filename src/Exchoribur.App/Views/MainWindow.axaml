<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Exchoribur.App.ViewModels"
        xmlns:controls="using:Exchoribur.App.Controls"
        xmlns:timeline="using:Exchoribur.App.TimelineUi"
        xmlns:views="using:Exchoribur.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="using:Exchoribur.App.Resources"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="Exchoribur.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon-symbol.ico"
        Width="1280" Height="760"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="{Binding WindowTitle}"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding Editing.UndoEditsCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding Editing.RedoEditsCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding Editing.SelectAllCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding Editing.CopyBlockToOtherChannelsCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding Editing.ClearSelectionCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding Editing.DeleteSelectedBlocksCommand}" />
        <KeyBinding Gesture="Shift+Delete" Command="{Binding Editing.BlockEditor.DeleteSelectedFramesCommand}" />
        <KeyBinding Gesture="Insert" Command="{Binding Editing.BlockEditor.InsertFrameAtPlayheadCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ChromeBackgroundBrush}">
            <MenuItem Header="{x:Static res:Strings.MainMenuFile}">
                <MenuItem Header="{x:Static res:Strings.MainMenuNewProject}"
                          Command="{Binding NewProjectCommand}" InputGesture="Ctrl+N">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.NewProject}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuOpenProject}" Command="{Binding OpenProjectCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.OpenProject}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuSaveProject}" Command="{Binding SaveProjectCommand}" InputGesture="Ctrl+S">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Save}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuSaveProjectAs}" Command="{Binding SaveProjectAsCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.SaveAs}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuImportTimeline}"
                          Command="{Binding OpenCommand}"
                          InputGesture="Ctrl+O">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Import}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuImportMedia}" Command="{Binding ImportVideoCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.ImportMedia}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuExportTimeline}" Command="{Binding ExportTimelineCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Export}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuExit}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MainMenuEdit}">
                <MenuItem Header="{Binding Editing.UndoLabel}"
                          Command="{Binding Editing.UndoEditsCommand}"
                          InputGesture="Ctrl+Z">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Undo}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding Editing.RedoLabel}"
                          Command="{Binding Editing.RedoEditsCommand}"
                          InputGesture="Ctrl+Y">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Redo}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuSelectAll}" Command="{Binding Editing.SelectAllCommand}" InputGesture="Ctrl+A">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Channels}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuClearSelection}"
                          Command="{Binding Editing.ClearSelectionCommand}"
                          InputGesture="Escape" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuCopyToOtherChannels}"
                          Command="{Binding Editing.CopyBlockToOtherChannelsCommand}"
                          InputGesture="Ctrl+D">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Copy}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuRenameBlock}" Command="{Binding Editing.RenameSelectedBlockCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.SetFunction}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuUsePlayheadColor}" Command="{Binding Editing.BlockEditor.SetSelectionColorCommand}">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.SetColor}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuInsertFrame}"
                          Command="{Binding Editing.BlockEditor.InsertFrameAtPlayheadCommand}"
                          InputGesture="Insert">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.InsertFrame}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuDeleteFrames}"
                          Command="{Binding Editing.BlockEditor.DeleteSelectedFramesCommand}"
                          InputGesture="Shift+Delete">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Delete}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.MainMenuDeleteBlocks}"
                          Command="{Binding Editing.DeleteSelectedBlocksCommand}"
                          InputGesture="Delete">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Delete}" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static res:Strings.MainMenuSettings}" Click="OnSettingsClick">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.Settings}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.MainMenuView}" IsEnabled="False" />
            <MenuItem Header="{x:Static res:Strings.MainMenuHelp}">
                <MenuItem Header="{x:Static res:Strings.MainMenuAbout}" IsEnabled="False">
                    <MenuItem.Icon>
                        <Path Classes="icon title" Data="{x:Static controls:Icons.About}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 底部状态栏:打开文件的结果、报错、保存进度都显示在这里 -->
        <Border DockPanel.Dock="Bottom"
                Height="26"
                Background="{DynamicResource ChromeBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Classes="status"
                           Classes.error="{Binding HasError}"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center" />
                 <!-- 保存/打开时才出现的细进度条:打包或解出大素材要等几十秒,没有它看不出还在动 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <ProgressBar Width="140"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BusyProgress}"
                                 IsVisible="{Binding IsBusy}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" />

                    <!-- 自动更新的提示:平时不出现,不占地方 -->
                    <Path Classes="icon"
                          Data="{x:Static controls:Icons.Download}"
                          IsVisible="{Binding Updates.IsUpdateBannerVisible}" />
                    <TextBlock Classes="update"
                               Text="{Binding Updates.UpdateBannerText}"
                               IsVisible="{Binding Updates.IsUpdateBannerVisible}" />
                    <Button Classes="transport"
                            ToolTip.Tip="{x:Static res:Strings.MainTooltipApplyUpdate}"
                            Command="{Binding Updates.InstallUpdateCommand}"
                            IsVisible="{Binding Updates.IsUpdateApplyVisible}">
                        <Path Classes="icon" Data="{x:Static controls:Icons.Refresh}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 全局播放条:这些控件管的是整条时间线,不属于某一块面板 -->
        <Border DockPanel.Dock="Bottom"
                Height="44"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <!--
                两侧列必须等宽(都是星号列),中间那组控件才会正好落在窗口正中;
                写成 Auto 的话左列宽度就等于读数框本身,右对齐也就无从谈起。
            -->
            <Grid ColumnDefinitions="*,Auto,*" Margin="12,0">
                <!--
                    播放条按"槽位"排:中间那组控件固定居中,左右各一个槽位放显示面板。
                    两侧列都是星号列、宽度相等,所以左右面板宽窄怎么变都不会推走中间。
                    槽位内的顺序就是离中心的远近,越靠后越靠外;面板绑自己的 IsVisible,
                    隐藏的项不占位,后面的自动顶上。
                -->
                <StackPanel x:Name="LeftSlot"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Spacing="8">
                  
                    <!-- 走带光标所在处的时间,紧贴中间按钮组的左边 -->
                    <Border Classes="readout">
                        <TextBlock Classes="clock"
                                   Text="{Binding Playback.PlayheadText}"
                                   VerticalAlignment="Center" />
                    </Border>
                  <Border Width="1"
                          Height="20"
                          Margin="8,0"
                          Background="{DynamicResource PanelBorderBrush}" />
                </StackPanel>
              

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                  

                  <!-- 中央播放控件 -->
                  <views:PlaybackControlsView DataContext="{Binding Playback}" />
                </StackPanel>

              <StackPanel x:Name="RightSlot"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Spacing="8" >
                
                <Border Width="1"
                        Height="20"
                        Margin="8,0"
                        Background="{DynamicResource PanelBorderBrush}" />

                <!-- 链接开关:白色=没选块;亮黄=选中的块都已链接(再点解除);紫色=混合(点一下重新链成一伙) -->
                <Button Classes="transport"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipLink}"
                        Command="{Binding Editing.ToggleLinkCommand}">
                    <Path Classes="icon big"
                          Data="{x:Static controls:Icons.Link}"
                          Stroke="{Binding Editing.LinkIconBrush}" />
                </Button>

                <!-- 场控设备:白色=面板收着,强调色=面板弹出来了 -->
                <ToggleButton Classes="transport device"
                              ToolTip.Tip="{x:Static res:Strings.MainTooltipDevicePanel}"
                              IsChecked="{Binding IsDevicePanelOpen}">
                    <Path Classes="icon big device" Data="{x:Static controls:Icons.SerialPort}" />
                </ToggleButton>

                <!--视频窗口弹出按钮-->
                <Button Classes="transport primary popout"
                        IsEnabled="{Binding Preview.HasVideo}"
                        ToolTip.Tip="{x:Static res:Strings.MainTooltipPopOutVideo}"
                        Click="OnPopOutVideoClick">
                  <Path Classes="icon big popout"
                        Data="{x:Static controls:Icons.PopOut}"/>
                </Button>
              </StackPanel>
                
            </Grid>
        </Border>

        <Grid ColumnDefinitions="340,*">
            <!-- 左栏:视频预览(播放控制压在它底部)+ 十通道状态(缩放压在它底部) -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="8">
                <Border Grid.Row="0" Classes="panel" Height="191">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="10,8,0,4">
                            <Path Classes="icon title" Data="{x:Static controls:Icons.ImportMedia}" />
                            <TextBlock Classes="panelTitle" Text="{x:Static res:Strings.MainPanelVideoPreview}" />
                        </StackPanel>

                        <controls:VideoSurface Frame="{Binding Preview.VideoFrame}"
                                               FrameVersion="{Binding Preview.VideoFrameVersion}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Classes="panel" Margin="0,8,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="10,8,0,4">
                            <Path Classes="icon title" Data="{x:Static controls:Icons.LightStatus}" />
                            <TextBlock Classes="panelTitle" Text="{x:Static res:Strings.MainPanelChannelState}" />
                        </StackPanel>

                        <controls:LightStatusControl CurrentFrame="{Binding Playback.CurrentFrame}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右栏:时间轴(主区域)+ 与时间轴对齐的音频波形;调色盘是浮在时间轴上的弹出面板 -->
            <Grid Grid.Column="1" Margin="0,8,8,8" RowDefinitions="*,110">
                <Border Grid.Row="0" Classes="panel" Margin="0,0,0,8">
                    <DockPanel>
                        <!-- 底部留一条窄条专门放缩放按钮,不压在轨道色块上 -->
                        <Border DockPanel.Dock="Bottom"
                                Height="26"
                                Background="{DynamicResource ChromeBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,3,3">
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- 滚轮分工提示:窗口窄的时候省略号收尾,不挤走右边的按钮 -->
                                <TextBlock Grid.Column="0"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DimTextBrush}"
                                           FontSize="12"
                                           Text="{x:Static res:Strings.MainTimelineWheelHint}" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Spacing="2"
                                            Margin="0,0,6,0">
                                    <Button Classes="transport"
                                            ToolTip.Tip="{x:Static res:Strings.MainTooltipZoomIn}"
                                            Command="{Binding Editing.ZoomInCommand}">
                                        <Path Classes="icon" Data="{x:Static controls:Icons.ZoomIn}" />
                                    </Button>
                                    <Button Classes="transport"
                                            ToolTip.Tip="{x:Static res:Strings.MainTooltipZoomOut}"
                                            Command="{Binding Editing.ZoomOutCommand}">
                                        <Path Classes="icon" Data="{x:Static controls:Icons.ZoomOut}" />
                                    </Button>
                                    <Button Classes="transport"
                                            ToolTip.Tip="{x:Static res:Strings.MainTooltipFitAll}"
                                            Command="{Binding Editing.FitAllCommand}">
                                        <Path Classes="icon" Data="{x:Static controls:Icons.FitAll}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--
                            刻度、标记、十条轨道、播放头都在同一个控件里画,
                            免得滚动时各层落在不同的合成帧上对不齐。
                            两行这样切:上面那行给轨道,下面那行的高度就是块编辑器的高度。
                            右边两列是调色盘和场控设备面板:各自弹出来时占一列,
                            轨道跟着让出这块宽度,谁都不挡谁;都不显示时时间轴是整宽的。
                        -->
                        <Grid ClipToBounds="True"
                              ColumnDefinitions="*,Auto,Auto"
                              RowDefinitions="*,Auto">
                            <timeline:TimelineControl
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Blocks="{Binding Editing.Blocks}"
                                Markers="{Binding Editing.Markers}"
                                Viewport="{Binding Editing.Viewport}"
                                PlayheadTime="{Binding Playback.PlayheadTime, Mode=TwoWay}"
                                SelectedBlocks="{Binding Editing.SelectedBlocks, Mode=TwoWay}"
                                CurrentBlockId="{Binding Editing.BlockEditor.CurrentBlockId}"
                                BottomOverlayHeight="{Binding Editing.BlockEditor.EditorOverlayHeight}"
                                EnsureVisibleChannel="{Binding Editing.BlockEditor.CurrentBlockChannel}"
                                InvertMouseWheel="{Binding Settings.Editing.InvertMouseWheel}"
                                InvertTouchpadScroll="{Binding Settings.Editing.InvertTouchpadScroll}"
                                BlockCreateRequested="OnBlockCreateRequested"
                                BlockMoveRequested="OnBlockMoveRequested"
                                BlockOpenRequested="OnBlockOpenRequested"
                                Cursor="Hand" />

                            <!--
                                调色盘:编辑窗打开时在右边占一列(上下顶满),编辑器收起就空出这一列,
                                不编辑的时候时间轴是整宽的。
                            -->
                            <Border Grid.Column="1"
                                    Grid.RowSpan="2"
                                    Width="220"
                                    IsVisible="{Binding Editing.BlockEditor.HasCurrentBlock}"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1,0,0,0">
                                <views:ColorPanelView />
                            </Border>

                            <!--
                                场控设备面板:底部工具栏那个按钮开关它。位置在调色盘右边、贴着窗口最右,
                                这样调色盘开合不会推着它动。
                            -->
                            <Border Grid.Column="2"
                                    Grid.RowSpan="2"
                                    Width="260"
                                    IsVisible="{Binding IsDevicePanelOpen}"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1,0,0,0">
                                <views:DevicePanelView />
                            </Border>

                            <!-- 块编辑器:盖在轨道上面(不挤压轨道),打开时主时间轴会把选中的块滚到它上面 -->
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Height="{Binding Editing.BlockEditor.EditorOverlayHeight}"
                                    IsVisible="{Binding Editing.BlockEditor.HasCurrentBlock}"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    BoxShadow="0 -8 18 0 #88000000">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Margin="10,6,0,2">
                                        <Path Classes="icon title" Data="{x:Static controls:Icons.SetColor}" />
                                        <TextBlock Classes="panelTitle" Text="{x:Static res:Strings.MainPanelBlockEditor}" />
                                        <TextBlock Classes="panelTitle" Text="{Binding Editing.BlockEditor.CurrentBlockTitle}" />
                                    </StackPanel>

                                    <timeline:BlockEditorControl
                                        Blocks="{Binding Editing.Blocks}"
                                        CurrentBlock="{Binding Editing.BlockEditor.CurrentBlock}"
                                        Viewport="{Binding Editing.BlockEditor.BlockEditorViewport}"
                                        PlayheadTime="{Binding Playback.PlayheadTime, Mode=TwoWay}"
                                        SelectedFrames="{Binding Editing.BlockEditor.SelectedFrames, Mode=TwoWay}"
                                        FocusTime="{Binding Editing.BlockEditor.CurrentBlockFocus}"
                                        FocusSpacing="{Binding Editing.BlockEditor.CurrentBlockSpacing}"
                                        InvertMouseWheel="{Binding Settings.Editing.InvertMouseWheel}"
                                        InvertTouchpadScroll="{Binding Settings.Editing.InvertTouchpadScroll}" />
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Classes="panel">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7">
                        <Path Classes="icon title" Data="{x:Static controls:Icons.AudioWaveform}" />
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.MainAudioWaveformPlaceholder}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>

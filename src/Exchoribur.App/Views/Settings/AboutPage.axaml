<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exchoribur.App.ViewModels"
             x:Class="Exchoribur.App.Views.Settings.AboutPage"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="10">
        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <TextBlock Classes="rowLabel"
                           FontSize="16"
                           Text="{Binding AppName}" />
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="rowLabel" Text="版本" />
                    <TextBlock Grid.Column="1"
                               Classes="rowValue"
                               Text="{Binding CurrentVersionText}" />
                </Grid>
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="rowLabel" Text="构建配置" />
                    <TextBlock Grid.Column="1"
                               Classes="rowValue"
                               Text="{Binding BuildConfigurationText}" />
                </Grid>
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="rowLabel" Text="许可" />
                    <TextBlock Grid.Column="1"
                               Classes="rowValue"
                               Text="{Binding LicenseText}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="settingsGroup">
            <StackPanel Spacing="8">
                <TextBlock Classes="panelTitle" Text="链接与声明" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开项目主页"
                            Click="OnOpenProjectUrlClick"
                            Padding="12,4" />
                    <Button Content="第三方组件声明"
                            Click="OnOpenNoticesClick"
                            Padding="12,4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>

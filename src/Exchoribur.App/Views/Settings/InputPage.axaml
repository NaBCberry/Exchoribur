<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exchoribur.App.ViewModels"
             x:Class="Exchoribur.App.Views.Settings.InputPage"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="10">
        <Border Classes="settingsGroup">
            <StackPanel Spacing="2">
                <CheckBox Content="反转鼠标滚轮方向"
                          IsChecked="{Binding InvertMouseWheel}" />
                <CheckBox Content="反转触摸板横向滑动方向"
                          Margin="0,8,0,0"
                          IsChecked="{Binding InvertTouchpadScroll}" />
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>

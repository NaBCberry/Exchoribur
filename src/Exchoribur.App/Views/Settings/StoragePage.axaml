<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exchoribur.App.ViewModels"
             xmlns:res="using:Exchoribur.App.Resources"
             x:Class="Exchoribur.App.Views.Settings.StoragePage"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="10">
        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <TextBlock Classes="rowLabel" Text="{x:Static res:Strings.SettingsStorageFilePath}" />
                <TextBlock Classes="rowValue"
                           Text="{Binding SettingsFilePath}"
                           TextWrapping="Wrap" />
                <Button Content="{x:Static res:Strings.SettingsStorageOpenFolder}"
                        Command="{Binding OpenSettingsFolderCommand}"
                        HorizontalAlignment="Left"
                        Padding="12,4" />
            </StackPanel>
        </Border>

        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <TextBlock Classes="rowLabel" Text="{x:Static res:Strings.SettingsResetButton}" />
                <TextBlock Classes="note"
                           Text="{x:Static res:Strings.SettingsStorageResetNote}" />
                <Button Content="{Binding ResetButtonText}"
                        Command="{Binding ResetToDefaultsCommand}"
                        HorizontalAlignment="Left"
                        Padding="12,4" />
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>

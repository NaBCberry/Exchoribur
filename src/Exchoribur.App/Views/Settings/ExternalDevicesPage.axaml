<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exchoribur.App.ViewModels"
             xmlns:res="using:Exchoribur.App.Resources"
             x:Class="Exchoribur.App.Views.Settings.ExternalDevicesPage"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="10">
        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <TextBlock Classes="rowLabel" Text="{x:Static res:Strings.SettingsDevicesOutputTitle}" />
                <TextBlock Classes="note"
                           Text="{x:Static res:Strings.SettingsDevicesOutputNote}" />
            </StackPanel>
        </Border>

        <Border Classes="settingsGroup">
            <StackPanel Spacing="4">
                <TextBlock Classes="panelTitle" Text="{x:Static res:Strings.SettingsDevicesPlannedTitle}" />
                <TextBlock Classes="rowValue" Text="{x:Static res:Strings.SettingsDevicesSerial}" />
                <TextBlock Classes="rowValue" Text="{x:Static res:Strings.SettingsDevicesBle}" />
                <TextBlock Classes="rowValue" Text="{x:Static res:Strings.SettingsDevicesUdp}" />
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>

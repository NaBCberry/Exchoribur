<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exchoribur.App.ViewModels"
             xmlns:res="using:Exchoribur.App.Resources"
             x:Class="Exchoribur.App.Views.Settings.UpdatesPage"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="10">
        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="rowLabel" Text="{x:Static res:Strings.SettingsUpdatesCurrentVersion}" />
                    <TextBlock Grid.Column="1"
                               Classes="rowValue"
                               Text="{Binding CurrentVersionText}" />
                </Grid>

                <TextBlock Classes="note"
                           IsVisible="{Binding !IsUpdateSupported}"
                           Text="{x:Static res:Strings.SettingsUpdatesUnsupportedNote}" />

                <CheckBox Content="{x:Static res:Strings.SettingsUpdatesCheckOnStartup}"
                          IsChecked="{Binding CheckForUpdatesOnStartup}"
                          IsEnabled="{Binding IsUpdateSupported}" />
                <CheckBox Content="{x:Static res:Strings.SettingsUpdatesAutoDownload}"
                          IsChecked="{Binding AutoDownloadUpdates}"
                          IsEnabled="{Binding IsUpdateSupported}" />
                <CheckBox Content="{x:Static res:Strings.SettingsUpdatesPrerelease}"
                          IsChecked="{Binding IncludePrereleaseVersions}"
                          IsEnabled="{Binding IsUpdateSupported}" />
            </StackPanel>
        </Border>

        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="rowLabel" Text="{x:Static res:Strings.SettingsUpdatesStatus}" />
                    <TextBlock Grid.Column="1"
                               Classes="rowValue"
                               MaxWidth="380"
                               TextWrapping="Wrap"
                               Text="{Binding UpdateStatusText}" />
                </Grid>

                <ProgressBar Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding UpdateProgress}"
                             IsVisible="{Binding IsUpdateProgressVisible}"
                             Foreground="{DynamicResource AccentBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.SettingsUpdatesCheckButton}"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding IsUpdateSupported}"
                            Padding="12,4" />
                    <Button Content="{x:Static res:Strings.SettingsUpdatesDownloadButton}"
                            Command="{Binding DownloadUpdateCommand}"
                            IsEnabled="{Binding CanDownloadUpdate}"
                            Padding="12,4" />
                    <Button Content="{x:Static res:Strings.SettingsUpdatesApplyButton}"
                            Command="{Binding ApplyUpdateCommand}"
                            IsEnabled="{Binding CanApplyUpdate}"
                            Padding="12,4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>

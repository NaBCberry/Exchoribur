<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Exchoribur.App.ViewModels"
             xmlns:res="using:Exchoribur.App.Resources"
             x:Class="Exchoribur.App.Views.Settings.UpdatesPage"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="10">
        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="rowLabel" Text="{x:Static res:Strings.SettingsUpdatesCurrentVersion}" />
                    <TextBlock Grid.Column="1"
                               Classes="rowValue"
                               Text="{Binding Updates.Status.CurrentVersionText}" />
                </Grid>

                <TextBlock Classes="note"
                           IsVisible="{Binding !Updates.Status.IsUpdateSupported}"
                           Text="{x:Static res:Strings.SettingsUpdatesUnsupportedNote}" />

                <CheckBox Content="{x:Static res:Strings.SettingsUpdatesCheckOnStartup}"
                          IsChecked="{Binding Updates.CheckForUpdatesOnStartup}"
                          IsEnabled="{Binding Updates.Status.IsUpdateSupported}" />
                <CheckBox Content="{x:Static res:Strings.SettingsUpdatesAutoDownload}"
                          IsChecked="{Binding Updates.AutoDownloadUpdates}"
                          IsEnabled="{Binding Updates.Status.IsUpdateSupported}" />
                <CheckBox Content="{x:Static res:Strings.SettingsUpdatesPrerelease}"
                          IsChecked="{Binding Updates.IncludePrereleaseVersions}"
                          IsEnabled="{Binding Updates.Status.IsUpdateSupported}" />
            </StackPanel>
        </Border>

        <Border Classes="settingsGroup">
            <StackPanel Spacing="6">
                <Grid Classes="settingsRow" ColumnDefinitions="*,Auto">
                    <TextBlock Classes="rowLabel" Text="{x:Static res:Strings.SettingsUpdatesStatus}" />
                    <TextBlock Grid.Column="1"
                               Classes="rowValue"
                               MaxWidth="380"
                               TextWrapping="Wrap"
                               Text="{Binding Updates.Status.UpdateStatusText}" />
                </Grid>

                <ProgressBar Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Updates.Status.UpdateProgress}"
                             IsVisible="{Binding Updates.Status.IsUpdateProgressVisible}"
                             Foreground="{DynamicResource AccentBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.SettingsUpdatesCheckButton}"
                            Command="{Binding Updates.Status.CheckCommand}"
                            IsEnabled="{Binding Updates.Status.IsUpdateSupported}"
                            Padding="12,4" />
                    <Button Content="{x:Static res:Strings.SettingsUpdatesInstallButton}"
                            Command="{Binding Updates.Status.InstallUpdateCommand}"
                            IsEnabled="{Binding Updates.Status.CanInstallUpdate}"
                            Padding="12,4" />
                </StackPanel>

                <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsUpdatesInstallNote}" />
            </StackPanel>
        </Border>
    </StackPanel>

</UserControl>

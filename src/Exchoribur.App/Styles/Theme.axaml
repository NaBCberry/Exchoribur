<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        配色参考 DaVinci Resolve 的深色界面:大面积中性深灰、低饱和,
        只在播放头和高亮上用一点暖色。数值都可以直接改,改完重跑就能看到。
    -->
    <Styles.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#202020" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#262626" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TextBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#8A8A8A" />
        <!-- 强调色,和播放头同色:保存进度条这类"还在动"的提示用它 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5A36" />
    </Styles.Resources>

    <!--
        界面字体:拉丁字母和数字用随程序打包的 Inter(设计类软件里最常见的选择),
        中文交给系统里的黑体。这里写的是候选列表,装了的第一个生效;
        缺字形时的逐字兜底在 Program.cs 的 FontManagerOptions 里配。
        FontFamily 是可继承属性,写在窗口上,里面所有文字都会跟着走。
    -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Source Han Sans SC, Segoe UI" />
    </Style>

    <Style Selector="TextBlock.menu">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.panelTitle">
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 底部状态栏:平时是灰色提示,报错时换成暖红,和播放头同一个色系 -->
    <Style Selector="TextBlock.status">
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.status.error">
        <Setter Property="Foreground" Value="#E0705C" />
    </Style>

    <!-- 设置页里挂在开关下面的说明文字 -->
    <Style Selector="TextBlock.note">
        <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        图标统一用描边绘制:Lucide 的图形本来就是笔画而不是填充区域,
        所以必须设 Stroke;宽高同时决定缩放比例。
    -->
    <Style Selector="Path.icon">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>

    <!-- 面板标题和菜单里的图标比按钮图标大一点,线条也相应粗一点 -->
    <Style Selector="Path.icon.title">
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
    </Style>

    <!-- 全局播放条上播放/停止/循环用的大图标 -->
    <Style Selector="Path.icon.big">
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!--
        颜色面板里的常用色块:颜色直接按在按钮自己的 Background 上,
        再把悬停和按下的底色钉回按钮自己的颜色,免得被主题的底色盖掉。
    -->
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    </Style>

    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    </Style>

    <Style Selector="Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    </Style>

    <!--
        播放、缩放这类图标按钮不带自己的框:它们直接压在视频预览框和通道面板上,
        所以底色透明、边框去掉,只在鼠标悬停和按下时给一层淡淡的亮色反馈。
    -->
    <Style Selector="Button.transport">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#26FFFFFF" />
    </Style>

    <Style Selector="Button.transport:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#40FFFFFF" />
    </Style>

    <!-- 循环这类开关按钮:开着的时候给一层暖色底,一眼能看出状态 -->
    <Style Selector="ToggleButton.transport:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33FF5A36" />
    </Style>

    <!-- ToggleButton 自带一套默认底色,不覆盖的话循环按钮平时会露出灰底 -->
    <Style Selector="ToggleButton.transport /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        播放/停止/循环这三个主控件不要灰底方块:悬停、按下、选中一律透明,
        只让图标自己变色。这几条必须放在上面那套通用规则之后,否则会被覆盖。
    -->
    <Style Selector="Button.transport.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.transport.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.transport.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.transport.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.transport.primary:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 播放:悬停变绿 -->
    <Style Selector="Button.transport.primary.play:pointerover Path.icon.play">
        <Setter Property="Stroke" Value="#5CCB5F" />
    </Style>

    <!-- 停止:悬停变红 -->
    <Style Selector="Button.transport.primary.stop:pointerover Path.icon.stop">
        <Setter Property="Stroke" Value="#E0574B" />
    </Style>

    <!-- 循环:平时跟别的图标一样是灰的,悬停或开着时才变橙 -->
    <Style Selector="ToggleButton.transport.primary.loop:pointerover Path.icon.loop">
        <Setter Property="Stroke" Value="#E8A33D" />
    </Style>

    <Style Selector="ToggleButton.transport.primary.loop:checked Path.icon.loop">
        <Setter Property="Stroke" Value="#E8A33D" />
    </Style>

</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        全程序共用的一套颜色
    -->
    <Styles.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1B1B" />
        <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#202020" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#262626" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TextBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#8A8A8A" />
        <!-- 强调色,和播放头同色:保存进度条、设置页选中项这类"当前"的提示用它 -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5A36" />

        <!--
            自绘时间轴用的颜色。这里放的是画刷,自绘控件只取它的颜色:
            填充直接用同色画刷,描边要建画笔(Pen 需要的是颜色)。
            键名与取值的对应关系由 TimelinePalette 维护,并有测试盯着两边不许写歪。
        -->
        <SolidColorBrush x:Key="TimelineTrackBackgroundBrush" Color="#151515" />
        <SolidColorBrush x:Key="TimelineRowBackgroundBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="TimelineDimTextBrush" Color="#8A8A8A" />
        <SolidColorBrush x:Key="TimelineBlockFillBrush" Color="#2E2E2E" />
        <SolidColorBrush x:Key="TimelineBlockTitleBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TimelineBlockTextBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="TimelinePlayheadBrush" Color="#FF5A36" />
        <SolidColorBrush x:Key="TimelineGutterBackgroundBrush" Color="#202020" />
        <SolidColorBrush x:Key="TimelineMarkerBrush" Color="#E0B457" />
        <SolidColorBrush x:Key="TimelineMarkerTagBrush" Color="#D9241C0E" />
        <SolidColorBrush x:Key="TimelineUnplayableMaskBrush" Color="#8C808080" />
        <SolidColorBrush x:Key="TimelineBoxSelectionFillBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="TimelineBoxSelectionBorderBrush" Color="#CCFFFFFF" />
        <SolidColorBrush x:Key="TimelineSelectionBorderBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TimelineMarkerLineBrush" Color="#66E0B457" />
        <SolidColorBrush x:Key="TimelineRowSeparatorBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="TimelineGutterDividerBrush" Color="#3A3A3A" />
        <SolidColorBrush x:Key="TimelineBlockBorderBrush" Color="#3F3F3F" />
        <SolidColorBrush x:Key="TimelineDimBlockFillBrush" Color="#242424" />
        <SolidColorBrush x:Key="TimelineDimBlockTextBrush" Color="#7A7A7A" />
        <SolidColorBrush x:Key="TimelineDimScrimBrush" Color="#99202020" />
        <SolidColorBrush x:Key="TimelineFrameTickBrush" Color="#B0FFFFFF" />
        <SolidColorBrush x:Key="TimelineFrameSelectionFillBrush" Color="#40FFFFFF" />
    </Styles.Resources>

</Styles>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Exchoribur</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon-symbol.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- 编辑器和 dotnet format 的设计时编译也需要资源访问器。 -->
  <Target Name="PrepareResourceAccessors" BeforeTargets="CoreCompile" DependsOnTargets="PrepareResources" />

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      界面文案的资源名显式写死:默认名是从 RootNamespace 拼出来的,谁改了工程名或
      RootNamespace,资源就会悄悄读不到(界面上一堆键名)。
    -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>Exchoribur.App.Resources.Strings.resources</LogicalName>
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedNamespace>Exchoribur.App.Resources</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
      <!-- Avalonia 的 x:Static 需要公开的属性。只从默认资源生成,翻译文件不生成类。 -->
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 关于页要能打开这三份声明,所以随程序一起发出去 -->
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ACKNOWLEDGEMENTS.md" Link="ACKNOWLEDGEMENTS.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- LGPL 与 OFL 要求随分发附上许可全文,单独放一个子目录 -->
    <Content Include="..\..\licenses\**" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 视频预览:LibVLCSharp 是托管封装,真正的解码器 libvlc 由下面各平台的包提供 -->
    <!-- Windows 和 macOS 直接带 libvlc;Linux 由发行版提供(libvlc-dev / vlc-plugin-base) -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Exchoribur.Core/Exchoribur.Core.csproj" />
    <ProjectReference Include="../Exchoribur.Application/Exchoribur.Application.csproj" />
    <ProjectReference Include="../Exchoribur.Infrastructure/Exchoribur.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 界面层的内部工具(时间轴刻度换算之类)允许测试工程直接调用 -->
    <InternalsVisibleTo Include="Exchoribur.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\VideoPreviewWindow.axaml.cs">
      <DependentUpon>VideoPreviewWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Exchoribur.App.App"
             xmlns:local="using:Exchoribur.App"
             RequestedThemeVariant="Dark">
             <!-- 配色是照深色界面调的,所以固定用 Dark,避免系统是浅色主题时菜单、
                  滚动条跟自绘控件对不上。以后要做主题切换再改成可配置。 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- 顺序有意义:先颜色,再全局样式,最后设置页自己的样式 -->
        <StyleInclude Source="avares://Exchoribur/Styles/Colors.axaml" />
        <StyleInclude Source="avares://Exchoribur/Styles/Theme.axaml" />
        <StyleInclude Source="avares://Exchoribur/Styles/Settings.axaml" />
    </Application.Styles>
</Application>

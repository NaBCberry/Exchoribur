<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FfmpegRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FfmpegRuntime>
    <FfmpegRuntime Condition="'$(FfmpegRuntime)' == ''">$(NETCoreSdkRuntimeIdentifier)</FfmpegRuntime>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Exchoribur.Core/Exchoribur.Core.csproj" />
    <ProjectReference Include="../Exchoribur.Application/Exchoribur.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Exchoribur.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../artifacts/native/ffmpeg/$(FfmpegRuntime)/**/*"
             Link="ffmpeg/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
